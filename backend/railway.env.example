# =============================================================================
# Variables para Railway — servicio backend (Root Directory: backend)
# =============================================================================

# OBLIGATORIO — sin esto arranca en perfil "dev" y falla la base de datos
SPRING_PROFILES_ACTIVE=prod

# --- Base de datos (solo DATABASE_URL, formato postgresql://…) ---
# Al vincular PostgreSQL, usa la referencia de Railway (NO jdbc: delante):
DATABASE_URL=${{Postgres.DATABASE_URL}}

# NO definas:
#   DB_URL, DB_USERNAME, DB_PASSWORD, PGHOST, VITE_*, ADMIN_USERNAME
#   CORS con http:// (usa https:// como arriba)

# --- JWT (Base64, mín. 32 bytes): openssl rand -base64 48 ---
JWT_SECRET=
JWT_EXPIRATION=86400000

# --- CORS (obligatorio): URL pública del frontend con https://, sin barra final ---
CORS_ALLOWED_ORIGINS=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}

# --- Admin inicial: pon bootstrap=true, redeploy, inicia sesión, luego false ---
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@event.com
ADMIN_INITIAL_PASSWORD=   # contraseña simple sin + ni / para evitar problemas en Railway
ADMIN_NOMBRE=Super Admin

# Login en /login: admin@event.com o admin + la contraseña de arriba (no el JWT_SECRET).
# Tras el primer login exitoso: ADMIN_BOOTSTRAP_ENABLED=false
