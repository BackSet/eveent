# =============================================================================
# Variables para Railway — servicio backend (Root Directory: backend)
# =============================================================================

# --- Base de datos ---
# Al vincular PostgreSQL a este servicio, Railway inyecta DATABASE_URL.
# DATABASE_URL=${{Postgres.DATABASE_URL}}

SPRING_PROFILES_ACTIVE=prod

# --- JWT (Base64, mín. 32 bytes): openssl rand -base64 48 ---
JWT_SECRET=
JWT_EXPIRATION=86400000

# --- CORS (obligatorio): URL pública del frontend, sin barra final ---
# Tras desplegar el frontend, pon su dominio aquí.
CORS_ALLOWED_ORIGINS=https://tu-frontend.up.railway.app

# --- Admin inicial (solo primer despliegue) ---
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_EMAIL=admin@event.com
ADMIN_INITIAL_PASSWORD=
ADMIN_NOMBRE=Super Admin

# Tras el primer login exitoso:
# ADMIN_BOOTSTRAP_ENABLED=false

# NO uses en este servicio: VITE_*, DB_USERNAME, DB_PASSWORD, PGHOST
