# Copia este archivo a `.env` en la misma carpeta y completa los valores.
# Spring Boot lee estas variables si las exportas al entorno o las cargas con tu IDE.
# Perfil activo por defecto: dev (ver application-dev.properties).

# --- Perfil ---
SPRING_PROFILES_ACTIVE=dev

# --- Base de datos (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/event
DB_USERNAME=postgres
DB_PASSWORD=

# --- Servidor ---
SERVER_PORT=8080

# --- JWT (obligatorio en producción: mínimo 32 caracteres aleatorios) ---
JWT_SECRET=
JWT_EXPIRATION=86400000

# --- CORS (orígenes del frontend, separados por coma) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Origin,Accept,X-Requested-With
CORS_EXPOSED_HEADERS=Authorization
CORS_MAX_AGE=3600

# --- Usuario administrador inicial (solo primer arranque con bootstrap) ---
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@event.com
ADMIN_INITIAL_PASSWORD=
ADMIN_NOMBRE=Super Admin
