# ============================================
# Event Backend - Variables de Entorno
# ============================================
# Copia este archivo como .env.local para valores locales (no se commitea)

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eventdb
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Admin inicial (SuperAdmin con todos los permisos)
ADMIN_EMAIL=admin@event.com
ADMIN_PASSWORD=Admin123!
ADMIN_NOMBRE=Super Admin

# JWT
JWT_SECRET=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2
JWT_EXPIRATION_MS=86400000

# CORS (origenes separados por coma)
CORS_ORIGINS=http://localhost:5173

# Puerto del servidor
SERVER_PORT=8080
