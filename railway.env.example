# =============================================================================
# Variables para Railway — despliegue unificado (un servicio + PostgreSQL)
# =============================================================================

# --- Servicio: PostgreSQL (plugin) ---
# Al vincular la base al servicio "app", Railway inyecta:
#   PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE, DATABASE_URL

# --- Servicio: app (raíz del repo, Dockerfile en /) ---
SPRING_PROFILES_ACTIVE=prod

# JWT en Base64 (mín. 32 bytes): openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=86400000

# Opcional: solo si accedes al API desde otro dominio (p. ej. app móvil).
# Con SPA y API en el mismo host no suele hacer falta.
# CORS_ALLOWED_ORIGINS=

# Primer despliegue: crear administrador (desactivar después)
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_EMAIL=admin@event.com
ADMIN_INITIAL_PASSWORD=
ADMIN_NOMBRE=Super Admin

# Tras el primer login exitoso:
# ADMIN_BOOTSTRAP_ENABLED=false
