# =============================================================================
# Variables para Railway — servicio frontend (Root Directory: frontend)
# =============================================================================

# Build-time (obligatorio). Usa HTTPS: el front en Railway es https:// y
# http:// provoca "contenido activo mixto" bloqueado por el navegador.
VITE_API_URL=https://${{backend.RAILWAY_PUBLIC_DOMAIN}}

# Opcional
VITE_APP_NAME=Event

# En el backend configura (también con https://):
#   CORS_ALLOWED_ORIGINS=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}
