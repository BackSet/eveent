# =============================================================================
# Variables para Railway — servicio frontend (Root Directory: frontend)
# =============================================================================

# Build-time (obligatorio). Usa HTTPS: el front en Railway es https:// y
# http:// provoca "contenido activo mixto" bloqueado por el navegador.
VITE_API_URL=https://${{backend.RAILWAY_PUBLIC_DOMAIN}}

# Opcional
VITE_APP_NAME=Event

# SEO y vista previa al compartir (URL pública del frontend, sin barra final)
VITE_SITE_URL=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}
VITE_APP_DESCRIPTION=Gestiona convocatorias deportivas, confirma asistencias y organiza alineaciones en un solo lugar.

# Google Search Console: código de verificación (meta tag)
# VITE_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4
# VITE_GA_MEASUREMENT_ID=

# En el backend configura (también con https://):
#   CORS_ALLOWED_ORIGINS=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}
