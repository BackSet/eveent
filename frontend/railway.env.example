# =============================================================================
# Variables para Railway — servicio frontend (Root Directory: frontend)
# =============================================================================

# Build-time: Railway pasa estas variables al build de Docker (ARG VITE_*)
# Despliega primero el backend y usa su URL pública aquí.
VITE_API_URL=https://tu-backend.up.railway.app

# Opcional
VITE_APP_NAME=Event

# Tras generar el dominio del frontend, configura en el backend:
#   CORS_ALLOWED_ORIGINS=https://tu-frontend.up.railway.app
#
# No hace falta definir PORT: Railway lo inyecta; Nginx escucha en ese puerto.
