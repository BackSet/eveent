# Copia este archivo a `.env` en la misma carpeta.
# Solo las variables con prefijo VITE_ están disponibles en el código del cliente.

# Desarrollo local (backend en :8080, frontend con npm run dev en :5173)
VITE_API_URL=http://localhost:8080

# Producción (build Docker/Railway): URL pública del backend
# VITE_API_URL=https://tu-backend.up.railway.app

# Nombre mostrado en la aplicación (opcional)
VITE_APP_NAME=Event

# URL pública del frontend (HTTPS, sin barra final). Obligatorio en producción para OG/SEO.
# VITE_SITE_URL=https://tu-frontend.up.railway.app

# Descripción para meta tags y vista previa al compartir
VITE_APP_DESCRIPTION=Gestiona convocatorias deportivas, confirma asistencias y organiza alineaciones en un solo lugar.

# Google Search Console: contenido del meta google-site-verification (solo el código, sin comillas)
# VITE_GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Analytics 4 (opcional)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
